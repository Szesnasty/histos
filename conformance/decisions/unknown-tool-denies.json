{
  "description": "A tool with no contract is never callable.",
  "policy": {
    "schema_version": "histos.policy/0.1",
    "tools": {
      "make_refund": {
        "access": "write",
        "args": {
          "order_id": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "tenant_id": {
            "type": "string"
          }
        },
        "bind": {
          "tenant_id": "principal.tenant_id"
        },
        "resource": {
          "owns": "tenant_id"
        }
      }
    },
    "roles": {
      "support": {
        "allow": [
          "make_refund"
        ]
      }
    }
  },
  "principal": {
    "role": "support",
    "attributes": {
      "tenant_id": "acme"
    }
  },
  "call": {
    "tool": "drop_database",
    "args": {}
  },
  "expect": {
    "effect": "deny",
    "rule": "unknown_tool"
  }
}
