# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Virtual environments
.venv/
.venv
venv/
env/
ENV/

# Local configuration and credentials. Keep an explicit example file if the
# project ever needs one, but never let a real dotenv file enter a release.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Runtime artifacts the gate itself writes — an audit trail is operational data
# (and can contain identities), never something to commit.
*.audit.jsonl
audit.jsonl

# demo scratch databases
*.db

# Generated by the mcp demo's import step. The *policy* is regenerated on every
# run, so it is scratch — but the *lock file* is the artifact the demo tells you
# to commit, and `histos drift` refuses to run without it. Ignoring it made the
# demo's own CI story impossible to follow from a clean checkout.
demo/04-mcp-rug-pull/docuvault.policy.json
!demo/04-mcp-rug-pull/docuvault.policy.lock.json
